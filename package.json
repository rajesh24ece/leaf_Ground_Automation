    "simple-git": "^3.36.0",
    "winston": "^3.19.0"
  },
  "name": "leaf_ground_automation",
  "version": "1.0.0",
  "description": "Portfolio-grade Playwright + TypeScript test automation framework with three-level POM architecture, GitHub Actions CI/CD, Allure reporting, and Slack notifications.",
